  document.getElementById('felh-jelszo').addEventListener('click', async (e) => {
    const g = e.currentTarget;
    const email = document.getElementById('felh-email').value.trim() || u.email;
    if (!email) { hiba('Ehhez a fiókhoz nincs e-mail cím, így nem tudok emlékeztetőt küldeni.'); return; }
    g.disabled = true; g.textContent = 'Készül...';
    try {
      const v = await httpsCallable(fuggvenyek, 'sendPasswordResetAdmin')({ email });
      const link = v.data && v.data.link;
      // A linket masolhato formaban adjuk: igy te dontod el, hogyan jut el hozza (e-mail, chat).
      prompt('Ezt a linket küldd el neki. Vele új jelszót tud beállítani:', link || '');
    } catch (err) {
      hiba(olvashatoHiba(err));
    }
    g.disabled = false; g.textContent = 'Jelszó-emlékeztető küldése';
  });

  document.getElementById('felh-torol').addEventListener('click', async (e) => {
    const g = e.currentTarget;
    const nev = u.name || u.email || 'ez a felhasználó';
    if (!confirm(`Biztosan törlöd a fiókot? "${nev}"\n\nEz elviszi az adatait is, és nem vonható vissza.`)) return;
    if (!confirm('Tényleg? Ez a második és utolsó kérdés.')) return;
    g.disabled = true; g.textContent = 'Törlés...';
    try {
      await httpsCallable(fuggvenyek, 'deleteAccount')({ uid: szerkesztettFelhasznalo.uid });
      szerkesztettFelhasznalo = null; await ujraRajzol();
    } catch (err) {
      g.disabled = false; g.textContent = 'Felhasználó törlése';
      hiba(olvashatoHiba(err));
    }
  });

  document.getElementById('felh-urlap').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const gomb = document.getElementById('felh-ment');
    hiba('');
    const adat = { uid: szerkesztettFelhasznalo.uid };
    const nev = document.getElementById('felh-nev').value.trim();
    const email = document.getElementById('felh-email').value.trim();
    const tier = document.getElementById('felh-tier').value;
    // Csak azt kuldjuk, ami TENYLEG valtozott: igy egy valtozatlan e-mail nem indit Auth-irast.
    if (nev !== (u.name || '')) adat.name = nev;
    if (email !== (u.email || '')) adat.email = email;
    if (tier !== (u.tier || 'Scout')) adat.tier = tier;
    const partner = document.getElementById('felh-partner').checked;
    if (partner !== !!u.partnerProgramEnabled) adat.partnerProgramEnabled = partner;
    if (Object.keys(adat).length === 1) { szerkesztettFelhasznalo = null; ujraRajzol(); return; }

    gomb.disabled = true; gomb.textContent = 'Mentés...';
    try {
      await httpsCallable(fuggvenyek, 'updateUserAdmin')(adat);
      szerkesztettFelhasznalo = null; await ujraRajzol();
    } catch (err) {
      gomb.disabled = false; gomb.textContent = 'Mentés';
      hiba(olvashatoHiba(err));
    }
  });
}

function csomagSzerkesztoEsemenyek() {
  kepFeltoltesEsemenyek();
  const hiba = (uz) => { const el = document.getElementById('cs-hiba'); el.hidden = !uz; el.textContent = uz || ''; };
  const szinBemenet = document.getElementById('cs-szin');

  document.getElementById('cs-szinek').addEventListener('click', (e) => {
    const g = e.target.closest('[data-szin]');
    if (!g) return;
    szinBemenet.value = g.dataset.szin;
    document.querySelectorAll('#cs-szinek .szin').forEach((x) => x.classList.toggle('valasztott', x === g));
  });

  document.getElementById('cs-megse').addEventListener('click', () => { szerkesztettCsomag = null; ujraRajzol(); });

  document.getElementById('csomag-urlap').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const gomb = document.getElementById('cs-ment');
    hiba('');
    const cim = document.getElementById('cs-cim').value.trim();
    if (!cim) { hiba('A csomag neve nem maradhat üresen.'); return; }

    const adat = {
      ...(szerkesztettCsomag.adat || {}),
      title: cim,
      tag: document.getElementById('cs-tag').value.trim(),
      category: document.getElementById('cs-kat').value.trim(),
      image: document.getElementById('cs-kep').value.trim(),
      color: szinBemenet.value,
      description: document.getElementById('cs-leiras').value.trim(),
      published: document.getElementById('cs-kint').checked,
      isPremium: document.getElementById('cs-premium').checked,
    };

    // A kivalasztott tervek: a MENTES UTAN kapjak meg a csomag azonositojat, mert uj csomagnal
    // az id csak a mentesbol derul ki.
    const bejelolt = Array.from(document.querySelectorAll('[data-terv]:checked')).map((x) => x.dataset.terv);
    const eredetiek = (utolsoTervLista || []).filter((t) => t.programId === szerkesztettCsomag.id).map((t) => t.id);

    gomb.disabled = true; gomb.textContent = 'Mentés...';
    try {
      const v = await httpsCallable(fuggvenyek, 'manageContent')({
        collection: 'programs', action: 'upsert', id: szerkesztettCsomag.id, data: adat,
      });
      const csomagId = szerkesztettCsomag.id || (v.data && (v.data.id || v.data.docId));
      if (!csomagId) throw new Error('nincs-azonosito');

      // Hozzaadas es kivetel: csak azokat a terveket irjuk, ahol TENYLEG valtozott a hovatartozas.
      const hozzaad = bejelolt.filter((id) => !eredetiek.includes(id));
      const kivesz = eredetiek.filter((id) => !bejelolt.includes(id));
      for (const id of hozzaad) {
        const t = (utolsoTervLista || []).find((x) => x.id === id) || {};
        await httpsCallable(fuggvenyek, 'manageContent')({
          collection: 'workoutPlans', action: 'upsert', id, data: { ...t, programId: csomagId },
        });
      }
      for (const id of kivesz) {
        const t = (utolsoTervLista || []).find((x) => x.id === id) || {};
        const uj = { ...t, programId: '' };   // ures string, NEM delete (a mentes merge-el, ld. fentebb)
        await httpsCallable(fuggvenyek, 'manageContent')({
          collection: 'workoutPlans', action: 'upsert', id, data: uj,
        });
      }
      szerkesztettCsomag = null; await ujraRajzol();
    } catch (err) {
      gomb.disabled = false; gomb.textContent = 'Mentés';
      hiba(olvashatoHiba(err));
    }
  });
}

/* HUZAS (drag & drop): a terv-kartyat egy csomag-savba ejtve atkerul oda.
   A mentes AZONNAL megy (manageContent), nincs kulon "mentes" gomb -- Szefi vizualis szerkesztest
   kert, ott a kulon mentes-lepes csak felesleges kor.
   Az egy-terv-egy-csomag szabaly igy is all: a terv programId-je egyszeruen atiródik. */
function huzasEsemenyek(cel) {
  let huzottId = null;

  cel.querySelectorAll('[data-terv-id]').forEach((k) => {
    k.addEventListener('dragstart', (e) => {
      huzottId = k.dataset.tervId;
      k.classList.add('huzas-alatt');
      e.dataTransfer.effectAllowed = 'move';
      // Firefox csak akkor indit huzast, ha van adat a dataTransfer-ben.
      e.dataTransfer.setData('text/plain', huzottId);
    });
    k.addEventListener('dragend', () => { k.classList.remove('huzas-alatt'); huzottId = null; });
  });

  cel.querySelectorAll('[data-drop]').forEach((zona) => {
    zona.addEventListener('dragover', (e) => { e.preventDefault(); zona.classList.add('cel-alatt'); });
    zona.addEventListener('dragleave', () => zona.classList.remove('cel-alatt'));
    zona.addEventListener('drop', async (e) => {
      e.preventDefault();
      zona.classList.remove('cel-alatt');
      const tervId = huzottId || e.dataTransfer.getData('text/plain');
      if (!tervId) return;
      const ujCsomag = zona.dataset.drop || '';
      const terv = (utolsoTervLista || []).find((t) => t.id === tervId);
      if (!terv) return;
      if ((terv.programId || '') === ujCsomag) return;   // nem valtozott, ne irjunk feleslegesen

      zona.classList.add('mentes-alatt');
      try {
        const adat = { ...terv };
        delete adat.id;
        /* FONTOS: a manageContent MERGE-gel ir, ezert egy mezot NEM lehet a torlesevel eltuntetni --
           a regi ertek egyszeruen megmarad. Szefi 2026-08-24-en pont ebbe futott: a csomagbol
           nem tudta kihuzni a tervet a "csomag nelkuli" savba. Ures string = nincs csomag. */
        adat.programId = ujCsomag || '';
        await httpsCallable(fuggvenyek, 'manageContent')({
          collection: 'workoutPlans', action: 'upsert', id: tervId, data: adat,
        });
        await ujraRajzol();
      } catch (err) {
        zona.classList.remove('mentes-alatt');
        alert(olvashatoHiba(err));
      }
    });
  });
}

