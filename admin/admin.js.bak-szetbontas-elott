/** Az urlapbol allitja ossze a mentendo tervet. A NEM ismert mezoket megtartja
 *  (az eredeti adatra epit), hogy egy jovobeli mezot ez a felulet ne toroljon le. */
function tervOsszeallit() {
  const eredeti = szerkesztettTetel.adat || {};
  const szam = (el) => { const v = el.value.trim(); return v === '' ? undefined : Number(v); };
  const gyakorlatok = Array.from(document.querySelectorAll('#gyak-lista [data-gyak]')).map((sor, i) => {
    const m = (nev) => sor.querySelector(`[data-g="${nev}"]`).value.trim();
    const regi = Array.isArray(eredeti.exercises) ? (eredeti.exercises[i] || {}) : {};
    const ki = { ...regi, name: m('name') };
    delete ki.completed;   // felhasznaloi allapot, nem tartozik a katalogusba
    if (!ki.id) ki.id = `ex-${Date.now()}-${i}`;
    const sets = m('sets');
    if (sets) ki.sets = Number(sets); else delete ki.sets;
    for (const k of ['reps', 'duration', 'videoUrl', 'imageUrl']) {
      const v = m(k);
      if (v) ki[k] = v; else delete ki[k];
    }
    return ki;
  }).filter((ex) => ex.name);   // nev nelkuli sor nem kerul be

  const ki = {
    ...eredeti,
    title: document.getElementById('terv-cim').value.trim(),
    intensity: document.getElementById('terv-intenzitas').value,
    frequency: document.getElementById('terv-gyakorisag').value.trim(),
    published: document.getElementById('terv-kint').checked,
    isPremium: document.getElementById('terv-premium').checked,
    exercises: gyakorlatok,
  };
  // Az `active` es a gyakorlatok `completed` mezoje FELHASZNALOI allapot, nem katalogus-adat.
  // A lib/workoutPlans.ts planToDoc-ja szandekosan kihagyja oket; itt sem irjuk be.
  delete ki.active;
  const hossz = szam(document.getElementById('terv-hossz'));
  if (hossz !== undefined) ki.duration = hossz;
  const kcal = szam(document.getElementById('terv-kcal'));
  if (kcal !== undefined) ki.kcal = kcal;
  const kep = document.getElementById('terv-kep').value.trim();
  if (kep) ki.image = kep; else delete ki.image;
  return ki;
}

function tervSzerkesztoEsemenyek() {
  kepFeltoltesEsemenyek();
  const lista = document.getElementById('gyak-lista');
