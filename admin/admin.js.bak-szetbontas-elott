/* A jelentes onmagaban CSAK annyit mondott, hogy "Poszt jelentve" + egy azonosito. Ugy nem lehet
   moderalni: a moderatornak LATNIA kell, MIT jelentettek. Ezert a jelentes melle betoltjuk a
   bejelentett tartalmat is (poszt szovege, kepe, szerzoje), es egy kattintassal torolheto.
   Szefi kerese (2026-08-24): "milyen jelenteseket kerultek be milyen posztok". */
async function jelentesekNezet() {
  const snap = await getDocs(query(collection(db, 'reports'), limit(100)));
  const tetelek = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
  if (!tetelek.length) return '<p class="ures">Nincs jelentés. Ez jó hír.</p>';

  /* A bejelentett tartalmak betoltese EGYSZERRE (nem sorban), kulonben 20 jelentesnel
     20 egymas utani kerest varnank meg. A hianyzot (mar torolt) nem tekintjuk hibanak. */
  const tartalmak = new Map();
  await Promise.all(tetelek.map(async (r) => {
    if (!r.targetId) return;
    const ut = r.targetType === 'user' ? 'users' : 'posts';
    try {
      const d = await getDoc(doc(db, ut, r.targetId));
      if (d.exists()) tartalmak.set(r.targetId, { ut, ...d.data() });
    } catch { /* jogosultsag vagy halozat -- a jelentes ettol meg latszodjon */ }
  }));

  const rend = { open: 0, reviewed: 1, actioned: 2 };
  tetelek.sort((a, b) => (rend[a.status] ?? 9) - (rend[b.status] ?? 9));

  const cimke = { open: ['nyitott', 'Nyitott'], reviewed: ['atnezve', 'Átnézve'], actioned: ['intezkedve', 'Intézkedve'] };
  return `<div class="lista">${tetelek.map((r) => {
    const [osztaly, nev] = cimke[r.status] || ['nyitott', r.status];
    const tart = tartalmak.get(r.targetId);
    const felhasznaloE = r.targetType === 'user';
    return `<article class="tetel jelentes">
      <div class="fo">
        <div class="jelentes-fej">
          <strong>${esc(felhasznaloE ? 'Felhasználó' : 'Poszt')} jelentve</strong>
          <span class="jelzo ${osztaly}">${esc(nev)}</span>
        </div>
        <div class="meta">Ok: ${esc(r.reason || '(nincs megadva)')}</div>

        ${tart ? `
          <div class="jelentett">
            <div class="jelentett-fej">
              ${tart.userAvatar || tart.avatar ? `<img class="jelentett-avatar" src="${esc(tart.userAvatar || tart.avatar)}" alt="" />` : ''}
              <strong>${esc(tart.userName || tart.name || '(névtelen)')}</strong>
              ${tart.timestamp ? `<span class="meta">${esc(String(tart.timestamp).slice(0, 16).replace('T', ' '))}</span>` : ''}
            </div>
            ${tart.content ? `<p class="jelentett-szoveg">${esc(tart.content)}</p>` : ''}
            ${tart.image ? `<img class="jelentett-kep" src="${esc(tart.image)}" alt="" />` : ''}
            ${felhasznaloE ? `<div class="meta">Szint: ${esc(tart.level ?? '?')} · ${esc(tart.tier || 'Scout')}</div>` : ''}
          </div>`
          : `<p class="jelentett hianyzik">A bejelentett tartalom már nem érhető el (törölték, vagy nincs jogom olvasni).</p>`}

        <div class="muveletek">
          <button data-jelentes="${esc(r.id)}" data-uj="reviewed" class="masodlagos">Átnézve</button>
          <button data-jelentes="${esc(r.id)}" data-uj="actioned">Intézkedve</button>
          <button data-jelentes="${esc(r.id)}" data-uj="open" class="masodlagos">Visszanyit</button>
          ${tart && !felhasznaloE
            ? `<button class="veszelyes kicsi" data-poszt-torol="${esc(r.targetId)}" data-jelentes-id="${esc(r.id)}">Poszt törlése</button>`
            : ''}
        </div>
      </div>
    </article>`;
  }).join('')}</div>`;
}

/* Az EDZESTERV nem sor, hanem KARTYA: Szefi (2026-08-24) azt kerte, hogy a listan is latszodjon
   a terv SZERKEZETE, ugy ahogy az appban meg fog jelenni -- kulonben csak nevek vannak, es
   szerkesztes elott meg kell nyitni mindet, hogy kiderüljon, melyik az. */
function tervKartya(t) {
  const gyak = Array.isArray(t.exercises) ? t.exercises : [];
  const videos = gyak.filter((e) => e && e.videoUrl).length;
  const elsok = gyak.slice(0, 4).map((e) => esc(e?.name || '(névtelen)')).join(' · ');
  const tobbi = gyak.length > 4 ? ` +${gyak.length - 4}` : '';
  return `
    <article class="terv-kartya">
      ${t.image ? `<div class="terv-kep" style="background-image:url('${esc(t.image)}')"></div>` : ''}
      <div class="terv-fo">
        <div class="terv-fej">
          <strong>${esc(t.title || '(névtelen terv)')}</strong>
          ${t.published === false
            ? '<span class="jelzo szunetel">Piszkozat, nincs kint</span>'
            : (t.isPremium ? '<span class="jelzo intezkedve">Prémium</span>' : '<span class="jelzo aktiv">Ingyenes</span>')}
        </div>
        <div class="terv-adatok">
          <span>${esc(t.intensity || '?')}</span>
          <span>${t.duration ? esc(t.duration) + ' perc' : 'hossz nincs'}</span>
          <span>${t.kcal ? esc(t.kcal) + ' kcal' : 'kalória nincs'}</span>
          <span>${esc(t.frequency || 'gyakoriság nincs')}</span>
        </div>
        <div class="terv-gyak">
          <strong>${gyak.length}</strong> gyakorlat${videos ? `, ebből <strong>${videos}</strong> videóval` : ', videó nélkül'}
          ${elsok ? `<div class="terv-elsok">${elsok}${tobbi}</div>` : ''}
        </div>
        <div class="muveletek">
          <button class="masodlagos" data-szerk="workoutPlans" data-id="${esc(t.id)}">Szerkesztés</button>
          <button class="masodlagos kicsi" data-masol="${esc(t.id)}" data-nev="${esc(t.title || '')}">Duplikálás</button>
          <button class="veszelyes kicsi" data-torol="workoutPlans" data-id="${esc(t.id)}" data-nev="${esc(t.title || '')}">Törlés</button>
        </div>
      </div>
    </article>`;
}

/* Egyesitett nezet: a csomagok HOSSZUKAS SAVOK, belejuk lehet HUZNI a terveket, alul pedig a
   csomag nelkuli tervek varakoznak. Szefi kerese (2026-08-24): "ne legyen kulon csomagok ful...
   szeretnek egy ilyen drag & drop reszt... VIZUALBAN is latszodjon".
   A huzas HTML5 drag&drop-pal megy: minden terv-kartya draggable, minden sav droppolhato. */
async function tervekNezet() {
  const [tervSnap, csomagSnap] = await Promise.all([
    getDocs(query(collection(db, 'workoutPlans'), limit(200))),
    getDocs(query(collection(db, 'programs'), limit(100))),
  ]);
  const tervek = tervSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
  const csomagok = csomagSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
  utolsoTervLista = tervek;
  utolsoCsomagLista = csomagok;

  csomagok.sort((a, b) => (a.sorrend ?? 999) - (b.sorrend ?? 999));

  const fejlec = `<div class="muveletek" style="margin-bottom:16px">
    <button data-uj="workoutPlans">Új edzésterv</button>
    <button class="masodlagos" data-uj-csomag>Új csomag</button>
    <button class="masodlagos" data-elonezet>Előnézet: hogy néz ki az appban</button>
  </div>
  <p class="ures" style="margin-bottom:14px">
    Fogd meg az edzéstervet és húzd bele egy csomagba. Ami nincs csomagban, az lent marad.
  </p>`;

  const csomagNelkul = tervek.filter((t) => !t.programId);

  const savok = csomagok.map((cs) => {
    const benne = tervek.filter((t) => t.programId === cs.id);
    const szin = cs.color || '#22c55e';
    return `
      <section class="csomag-sav" data-csomag-sav="${esc(cs.id)}" style="--csomag-szin:${esc(szin)}">
        <header class="csomag-fej">
          <span class="fogo" data-csomag-fogo title="Húzd fel-le a sorrendhez">⋮⋮</span>
          <strong>${esc(cs.title || '(névtelen csomag)')}</strong>
          ${cs.tag ? `<span class="jelzo">${esc(cs.tag)}</span>` : ''}
          ${cs.published === false ? '<span class="jelzo szunetel">Piszkozat</span>' : ''}
          ${cs.isPremium === false ? '<span class="jelzo aktiv">Ingyenes</span>' : '<span class="jelzo intezkedve">Prémium</span>'}
          <span class="csomag-db">${benne.length} terv</span>
          <span class="csomag-muveletek">
            <button class="masodlagos kicsi" data-csomag-szerk="${esc(cs.id)}">Szerkesztés</button>
            <button class="veszelyes kicsi" data-csomag-torol="${esc(cs.id)}" data-nev="${esc(cs.title || '')}">Törlés</button>
          </span>
        </header>
        <div class="csomag-tartalom" data-drop="${esc(cs.id)}">
          ${benne.length ? benne.map(huzhatoTerv).join('') : '<p class="ures dobj-ide">Húzz ide edzésterveket</p>'}
        </div>
      </section>`;
  }).join('');

  return fejlec + savok + `
    <section class="csomag-sav nincs-csomag">
      <header class="csomag-fej"><strong>Csomag nélküli tervek</strong>
        <span class="csomag-db">${csomagNelkul.length} terv</span></header>
      <div class="csomag-tartalom" data-drop="">
        ${csomagNelkul.length ? csomagNelkul.map(huzhatoTerv).join('') : '<p class="ures dobj-ide">Minden terv csomagban van.</p>'}
      </div>
    </section>`;
}

/** Egy terv HUZHATO kis kartyaja a savokban. Rovid, hogy sok elferjen egymas mellett. */
function huzhatoTerv(t) {
  const gyak = Array.isArray(t.exercises) ? t.exercises.length : 0;
  return `
    <article class="huzhato" draggable="true" data-terv-id="${esc(t.id)}">
      ${t.image ? `<div class="huzhato-kep" style="background-image:url('${esc(t.image)}')"></div>` : ''}
      <div class="huzhato-fo">
        <strong>${esc(t.title || '(névtelen)')}</strong>
        <div class="huzhato-meta">
          ${esc(t.intensity || '?')} · ${gyak} gyakorlat
          ${t.published === false ? ' · <span class="piszkozat-jel">piszkozat</span>' : ''}
        </div>
      </div>
      <div class="huzhato-gombok">
        <button class="masodlagos kicsi" data-szerk="workoutPlans" data-id="${esc(t.id)}">Szerk.</button>
        <button class="masodlagos kicsi" data-masol="${esc(t.id)}" data-nev="${esc(t.title || '')}">Másol</button>
        <button class="veszelyes kicsi" data-torol="workoutPlans" data-id="${esc(t.id)}" data-nev="${esc(t.title || '')}">Törlés</button>
      </div>
    </article>`;
}

async function tartalomNezet(kollekcio, cimMezo) {
  const snap = await getDocs(query(collection(db, kollekcio), limit(100)));
  const tetelek = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
  const fejlec = `<div class="muveletek" style="margin-bottom:14px">
    <button data-uj="${esc(kollekcio)}">Új felvétele</button></div>`;
  if (!tetelek.length) {
    return fejlec + `<p class="ures">Ez a gyűjtemény üres. Az app ilyenkor a beépített tartaléklistát használja.</p>`;
  }
  return fejlec + `<div class="lista">${tetelek.map((t) => `
    <article class="tetel">
      <div class="fo">
        <strong>${esc(t[cimMezo] || t.name || t.title || '(névtelen)')}</strong>
        <div class="meta">Azonosító: ${esc(t.id)}</div>
        <div class="muveletek">
          <button class="masodlagos" data-szerk="${esc(kollekcio)}" data-id="${esc(t.id)}">Szerkesztés</button>
        </div>
      </div>
      ${t.isPremium ? '<span class="jelzo intezkedve">Prémium</span>' : ''}
    </article>`).join('')}</div>`;
}

/* ------------------------------ edzés-csomagok ------------------------------
 * Szefi kerese (2026-08-24): egy csomag tobb tervet fog ossze, sajat nevvel es SZINNEL,
 * influencerhez kotve. Dontese: egy terv PONTOSAN EGY csomagba tartozik -- ha ugyanaz kell
 * masik csomagba, a tervet DUPLIKALNI kell (ezert van a kartyan Duplikalas gomb).
 * "a csoportok szerintem mindenkeppen fizetosek lesznek" -> uj csomag alapbol premium.
 * -------------------------------------------------------------------------- */

const CSOMAG_SZINEK = ['#22c55e', '#3b82f6', '#a855f7', '#f59e0b', '#ef4444', '#14b8a6'];

async function csomagokNezet() {
  const [csomagSnap, tervSnap] = await Promise.all([
    getDocs(query(collection(db, 'programs'), limit(100))),
    getDocs(query(collection(db, 'workoutPlans'), limit(200))),
  ]);
  const csomagok = csomagSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
  const tervek = tervSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
  utolsoTervLista = tervek;

  const fejlec = `<div class="muveletek" style="margin-bottom:14px">
    <button data-uj-csomag>Új csomag</button></div>`;
  if (!csomagok.length) {
    return fejlec + `<p class="ures">Még nincs egyetlen csomag sem. Az appban jelenleg a beépített
      minta-programok látszanak, azokat ezek fogják leváltani.</p>`;
  }
  return fejlec + `<div class="terv-lista">${csomagok.map((cs) => {
    const benne = tervek.filter((t) => t.programId === cs.id);
    const szin = cs.color || '#22c55e';
    return `
      <article class="terv-kartya" style="border-left:4px solid ${esc(szin)}">
        ${cs.image ? `<div class="terv-kep" style="background-image:url('${esc(cs.image)}')"></div>` : ''}
        <div class="terv-fo">
          <div class="terv-fej">
            <strong>${esc(cs.title || '(névtelen csomag)')}</strong>
            ${cs.published === false
              ? '<span class="jelzo szunetel">Piszkozat</span>'
              : (cs.isPremium === false ? '<span class="jelzo aktiv">Ingyenes</span>' : '<span class="jelzo intezkedve">Prémium</span>')}
          </div>
          ${cs.tag || cs.category ? `<div class="terv-adatok">
            ${cs.tag ? `<span>${esc(cs.tag)}</span>` : ''}
            ${cs.category ? `<span>${esc(cs.category)}</span>` : ''}</div>` : ''}
          <div class="terv-gyak">
            <strong>${benne.length}</strong> edzésterv van benne
            ${benne.length ? `<div class="terv-elsok">${benne.slice(0, 4).map((t) => esc(t.title || '?')).join(' · ')}${benne.length > 4 ? ` +${benne.length - 4}` : ''}</div>` : ''}
          </div>
          <div class="muveletek">
            <button class="masodlagos" data-csomag-szerk="${esc(cs.id)}">Szerkesztés</button>
            <button class="veszelyes kicsi" data-csomag-torol="${esc(cs.id)}" data-nev="${esc(cs.title || '')}">Törlés</button>
          </div>
        </div>
      </article>`;
  }).join('')}</div>`;
}

