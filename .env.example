# Az /admin/ felulet Firebase-konfigja. A VALODI ertekek a Fitron app .env-jeben vannak
# (C:/FitronBuild/.env), es a Netlify build-kornyezeteben kell majd beallitani oket.
#
# FIGYELEM: ezek NEM titkok (a Firebase web-konfig minden latogatohoz kimegy), DE
# a repoba akkor sem irjuk bele oket, hogy egy helyen legyenek kezelve.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
